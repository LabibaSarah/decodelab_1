/* Google Font */
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap');

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Inter', sans-serif;
    background: #f4f7fb;
    color: #222;
    line-height: 1.6;
}

/* Header */
.header {
    background: #1f2937;
    padding: 1rem 2rem;
    position: sticky;
    top: 0;
    z-index: 100;
}

.navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo {
    color: white;
    font-size: 1.8rem;
}

.nav-links {
    display: none;
    list-style: none;
    gap: 1.5rem;
}

.nav-links a {
    color: white;
    text-decoration: none;
    transition: 0.3s;
}

.nav-links a:hover {
    color: #60a5fa;
}

#menu-btn {
    background: none;
    border: none;
    color: white;
    font-size: 1.5rem;
    cursor: pointer;
}

/* Hero Section */
.hero {
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2rem;
    background: linear-gradient(135deg, #60a5fa, #a78bfa);
    color: white;
}

.hero-content {
    max-width: 700px;
}

.hero h2 {
    font-size: clamp(2rem, 5vw, 4rem);
    margin-bottom: 1rem;
}

.hero p {
    margin-bottom: 1.5rem;
    font-size: 1.1rem;
}

.hero-btn {
    padding: 0.8rem 1.5rem;
    border: none;
    background: white;
    color: #1f2937;
    font-weight: bold;
    border-radius: 8px;
    cursor: pointer;
    transition: 0.3s;
}

.hero-btn:hover {
    transform: scale(1.05);
}

/* Features */
.features {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    padding: 3rem 2rem;
}

.card {
    background: white;
    padding: 2rem;
    border-radius: 12px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    transition: 0.3s;
}

.card:hover {
    transform: translateY(-5px);
}

/* Task Section */
.task-section {
    padding: 3rem 2rem;
}

.task-section h2 {
    text-align: center;
    margin-bottom: 2rem;
}

.task-input {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2rem;
}

.task-input input {
    padding: 0.9rem;
    border: 1px solid #ccc;
    border-radius: 8px;
    font-size: 1rem;
}

.task-input button {
    padding: 0.9rem;
    border: none;
    background: #2563eb;
    color: white;
    border-radius: 8px;
    cursor: pointer;
}

#taskList {
    list-style: none;
}

.task-item {
    background: white;
    padding: 1rem;
    margin-bottom: 1rem;
    border-radius: 8px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
}

.completed {
    text-decoration: line-through;
    opacity: 0.6;
}

.delete-btn {
    background: crimson;
    color: white;
    border: none;
    padding: 0.5rem 0.8rem;
    border-radius: 5px;
    cursor: pointer;
}

/* Footer */
.footer {
    background: #111827;
    color: white;
    text-align: center;
    padding: 1rem;
    margin-top: 2rem;
}

/* Tablet View */
@media (min-width: 768px) {

    .nav-links {
        display: flex;
    }

    #menu-btn {
        display: none;
    }

    .features {
        grid-template-columns: repeat(2, 1fr);
    }

    .task-input {
        flex-direction: row;
    }

    .task-input input {
        flex: 1;
    }
}

/* Desktop View */
@media (min-width: 1024px) {

    .features {
        grid-template-columns: repeat(3, 1fr);
    }

    .hero {
        padding: 4rem;
    }
}